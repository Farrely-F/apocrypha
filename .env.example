# Copy to .env.local and fill in. Never commit real values.

# Random secret for signing sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app. GitHub callback = ${BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# file: for local/self-hosted (default), libsql:// for Turso
DATABASE_URL=file:./data/apocrypha.db

# Only needed for libsql:// (Turso) URLs; leave empty for file:
DATABASE_AUTH_TOKEN=

# Dev only: set to 1 to allow email+password sign-in for tests (ignored in production)
APOCRYPHA_TEST_AUTH=

# Audit log retention in days (default 180)
AUDIT_RETENTION_DAYS=

# Reverse proxies in front of the app, for finding the client address in rate limits (default 1; 0 = none)
TRUSTED_PROXY_HOPS=
